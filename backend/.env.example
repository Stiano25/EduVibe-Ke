# Copy to .env and fill in values.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# FRONTEND_URL=http://localhost:5173

# Lesson generation provider: claude (default) | gemini
# GENERATION_PROVIDER=claude
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# Batched quiz QA after lesson generation (default on). Set false or 0 to skip.
# QUIZ_QA_ENABLED=true
