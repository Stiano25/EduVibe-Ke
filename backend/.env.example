# Copy into .env and fill keys as needed

# gemini | groq | ollama
AI_PROVIDER=gemini

# Google Gemini (low free-tier caps on some models)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq free cloud — https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Local unlimited testing — https://ollama.com
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# JWT Authentication (required for /api/admin and protected /api/learner routes)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# HMAC for adaptive quiz session blobs (falls back to JWT_SECRET if unset)
SESSION_SIGNING_SECRET=
